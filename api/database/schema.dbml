// ============================================
// "Allt om"-plattformen – databasschema v4
// Klistra in på https://dbdiagram.io
//
// ÄNDRAT I V4 (efter granskning av v3):
//
// Blockerare:
//  1. business_locations: unika (business_id, kommun_id) BORTTAGET
//     → flera adresser per ort tillåtna. Ny partiell unik på is_primary.
//  2. opening_hours: unika (location, weekday) BORTTAGET
//     → flera intervall per dag (lunchstängt). Ny opening_hour_exceptions.
//  3. slugs: ny polymorf tabell med locale + historiska rader
//     → slug per språk OCH gratis 301:or vid namnbyte och vid migreringen.
//     slug-kolumnen är borttagen ur articles/events/pages/business_locations.
//  4. content_status bantad till draft/published/archived
//     → revisions är inkorg, status på raden är sanningen. Se REGEL nedan.
//  5. tinyint → smallint (finns inte i PostgreSQL).
//
// Bör-fixar:
//  6. site_kommun (pivot) ersätter sites.kommun_id
//     → en sajt kan täcka flera kommuner ("Allt om Västerbergslagen").
//  7. events: all_day, parent_event_id + recurrence_rule (återkommande).
//  8. events.kommun_id sätts bara om den är null – observern skriver inte över.
//  9. newsletter_subscribers.token unik + consent_ip/consent_source (GDPR-bevis).
// 10. business_claims: väg för ägare att ta över en redaktionell post.
//
// Mindre:
//  - promotions.status (pausa utan att redigera datum)
//  - lunch_menus: iso_year, deleted_at
//  - framtid_standings nycklas på external_team_id, inte team_name
//  - articles.author_id / revisions.submitted_by nullable (GDPR-radering)
//  - pages: två partiella index istället för coalesce
//
// REGEL FÖR PUBLICERING (v4 – gäller allt innehåll):
//  status på raden = vad som ligger ute. Punkt.
//  revisions = inkorg med föreslagna ändringar som ännu inte rörts vid raden.
//  Godkännande skriver payload till raden, sätter status och stämplar
//  applied_at. Avslag rör aldrig raden. Godkända revisioner sparas som
//  versionshistorik. "Väntar på granskning" är en fråga mot revisions,
//  inte ett tillstånd på innehållet.
//
// IMPLEMENTATIONSNOT – enums:
// Enum-blocken är dokumentation. I Laravel-migrations: varchar + backed
// enums i PHP (ContentStatus::Published), INTE databasens ENUM-typ.
//
// DATABAS: PostgreSQL.
// Partiella unika index (soft delete + unika slugs) och jsonb för
// översättningsbara fält.
//
// AVVIKELSER I IMPLEMENTATIONEN (api/, 2026-10-26):
//  - kommuner.lat/lng är nullable – seed-datan har koordinater bara för Dalarna.
//  - slugs.kommun_id har FK (restrict) – Ref saknades i originalet.
//  - ON DELETE-regler står på Ref-raderna som [delete: cascade / set null / restrict].
//    Originalet angav inga, så valen är implementationens.
//  - slugs har ingen deleted_at: en soft-raderad post behåller sina slugs (301),
//    raderna städas först vid hård radering (HasSlugs).
//  - setSlug() krockar aldrig: upptagen slug får suffix -2, -3 ... inom locale/kommun/typ.
//  - slugs.locale varchar(8), newsletter_subscribers.consent_ip varchar(45).
//  - business_locations.status + published_at (2026-10-28): v4 gav lokaliseringar ingen egen
//    status, men de går genom godkännandeflödet som allt annat (revisionable_type business_location).
//    Utan status blev en ny filial synlig i katalogen så fort utkastraden fanns, innan revisionen var
//    godkänd. Nu gäller samma regel som för resten: draft tills ApproveRevision publicerar, och
//    katalogen visar bara published-rader vars företag också är published.
// ============================================
// ---------- Enums (dokumentation, implementeras som varchar) ----------
// v4: pending och rejected borttagna – de bodde redan i revision_status
Enum content_status {
  draft
  published
  archived
}
Enum site_status {
  active
  coming_soon
  hidden
}
Enum managed_by {
  self
  editorial
}
Enum category_type {
  business
  event
  sport [note: 'Fotboll, ishockey, innebandy ... – används av framtida sportmodulen']
}
Enum revision_status {
  pending
  approved
  rejected
}
Enum claim_status {
  pending
  approved
  rejected
}
Enum promotion_status {
  draft
  active
  paused
  ended
}
Enum promotion_placement {
  startsida
  kategorisida
  evenemangskalender
  nyhetsbrev
}
// ============================================
// GEOGRAFI
// ============================================
Table lan {
  id bigint [pk, increment]
  namn varchar [note: '"Dalarnas län"']
  kod char(2) [unique, note: 'SCB länskod, "20"']
}
Table kommuner {
  id bigint [pk, increment]
  lan_id bigint [not null]
  namn varchar [note: '"Ludvika"']
  kod char(4) [unique, note: 'SCB kommunkod, "2085"']
  slug varchar [unique]
  lat decimal(10,7) [null, note: 'null tills koordinat finns – seedas bara för Dalarna i v1']
  lng decimal(10,7) [null]
  Note: 'Seedas från SCB. Koordinater för SMHI-vädret.'
}
Table sites {
  id bigint [pk, increment]
  namn varchar [note: '"Allt om Ludvika", "Allt om Västerbergslagen"']
  slug varchar [unique]
  domain varchar [unique, null, note: 'null = nås via sökväg']
  primary_kommun_id bigint [null, note: 'Ort för väder, startsidans fokus och kanonisk URL när sajten täcker flera']
  status site_status [default: 'coming_soon']
  settings json [null]
  created_at timestamp
  updated_at timestamp
  Note: 'v4: kommun_id ersatt av site_kommun-pivoten. Innehåll hör fortfarande hemma i EN kommun – sajten bestämmer bara vilka kommuner den visar.'
}
Table site_kommun {
  site_id bigint
  kommun_id bigint
  sort_order smallint [default: 0]
  indexes {
    (site_id, kommun_id) [pk]
    kommun_id [note: 'Vilka sajter visar den här kommunen?']
  }
  Note: 'v4: gör "Allt om Västerbergslagen" (Ludvika + Smedjebacken) möjlig utan att röra listvyerna. Listfrågor blir kommun_id IN (...).'
}
Ref: kommuner.lan_id > lan.id [delete: restrict]
Ref: site_kommun.site_id > sites.id [delete: cascade]
Ref: site_kommun.kommun_id > kommuner.id [delete: cascade]
Ref: sites.primary_kommun_id >? kommuner.id [delete: set null]
// ============================================
// ANVÄNDARE & ROLLER
// ============================================
Table users {
  id bigint [pk, increment]
  name varchar
  email varchar [unique]
  phone varchar [null]
  password varchar
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null, note: 'v4: GDPR – anonymisera namn/epost vid radering, behåll raden så FK:erna håller']
  Note: 'Plattformsroller via spatie/laravel-permission (admin, redaktor, verksamhetsagare)'
}
Table roles {
  id bigint [pk, increment]
  name varchar [note: 'admin / redaktor / verksamhetsagare']
  guard_name varchar
}
Table model_has_roles {
  role_id bigint
  model_type varchar
  model_id bigint
  indexes {
    (role_id, model_id, model_type) [pk]
  }
}
Ref: model_has_roles.role_id > roles.id
// ============================================
// SLUGS (v4) – URL:er per språk + historik
// ============================================
Table slugs {
  id bigint [pk, increment]
  slugable_type varchar [note: 'Polymorf: Article / Event / Page / BusinessLocation']
  slugable_id bigint
  kommun_id bigint [null, note: 'null = nationell (t.ex. integritetspolicy)']
  locale varchar(8) [note: '"sv", "en", "ar" ... – en rad per språk']
  slug varchar
  is_canonical boolean [default: true, note: 'false = gammal URL som ska 301:a hit']
  created_at timestamp
  indexes {
    (locale, kommun_id, slugable_type, slug) [unique, note: 'Partiellt index i Postgres. För nationella rader (kommun_id null) behövs ett eget: UNIQUE (locale, slugable_type, slug) WHERE kommun_id IS NULL']
    (slugable_type, slugable_id, locale)
  }
  Note: 'v4: löser två saker med en mekanism. (1) Slug per språk – v3 hade en enda varchar, så alla sju språken delade URL fast titeln var översatt. (2) Gratis 301:or: byter redaktören namn skrivs den gamla raden om till is_canonical=false istället för att raderas, och Next slår upp och redirectar. Samma mekanism tar hand om URL-pariteten vid migreringen från Wagtail – lägg in de gamla sökvägarna som icke-kanoniska rader.'
}
Ref: slugs.kommun_id >? kommuner.id [delete: restrict]
// ============================================
// KATEGORIER (nationella)
// ============================================
Table categories {
  id bigint [pk, increment]
  parent_id bigint [null]
  type category_type
  namn json [note: '{"sv": "...", "en": "..."}']
  slug varchar [note: 'Ett slug för alla språk – kategorier är få och byter sällan namn. Vill du översätta dem senare: flytta in dem i slugs-tabellen.']
  icon varchar [null]
  sort_order smallint [default: 0]
  indexes {
    (slug, type) [unique]
  }
}
Ref: categories.parent_id >? categories.id [delete: set null]
Table business_category {
  business_id bigint
  category_id bigint
  indexes {
    (business_id, category_id) [pk]
  }
  Note: 'Kategorier sätts på företaget, inte per lokalisering. OBS: databasen kan inte tvinga att kategorin har type=business – validera i applikationen.'
}
Table event_category {
  event_id bigint
  category_id bigint
  indexes {
    (event_id, category_id) [pk]
  }
  Note: 'Samma sak här: type=event måste valideras i koden.'
}
Ref: business_category.category_id > categories.id [delete: cascade]
Ref: event_category.category_id > categories.id [delete: cascade]
// ============================================
// VERKSAMHETER (företag + lokaliseringar)
// ============================================
Table businesses {
  id bigint [pk, increment]
  kind varchar [default: 'company', note: 'v1-förberedelse för sport: company / association – föreningar delar katalog, locations, portal och godkännandeflöde med företag']
  managed_by managed_by [default: 'editorial']
  auto_approve boolean [default: false]
  namn varchar
  beskrivning json [note: 'Översättningsbar – gemensam för alla orter']
  epost varchar [null]
  webbplats varchar [null]
  status content_status [default: 'draft']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  Note: 'Företaget – vem man är. Användarkopplingen bor i business_user.'
}
Table business_user {
  business_id bigint
  user_id bigint
  role varchar [default: 'owner', note: 'owner / manager – styr t.ex. vem som får bjuda in fler']
  created_at timestamp
  indexes {
    (business_id, user_id) [pk]
  }
  Note: 'En restaurang kan ha ägare + anställd som båda uppdaterar lunchen.'
}
Ref: business_user.business_id > businesses.id [delete: cascade]
Ref: business_user.user_id > users.id [delete: cascade]
Table business_claims {
  id bigint [pk, increment]
  business_id bigint [not null]
  user_id bigint [not null]
  status claim_status [default: 'pending']
  verified_via varchar [null, note: 'Hur identiteten styrktes: epost-domän / telefon / brev / bolagsuppgift']
  message text [null, note: 'Vad den sökande skrev']
  handled_by bigint [null]
  handled_at timestamp [null]
  created_at timestamp
  indexes {
    (business_id, status)
  }
  Note: 'v4: saknades helt i v3. Redaktionen lägger in ett café; ägaren hör av sig och vill sköta det själv. Godkänt anspråk skapar business_user-rad och sätter businesses.managed_by = self. Utan den här tabellen sker det via mejl och minne, och det finns inget spår av vem som släppte in vem.'
}
Ref: business_claims.business_id > businesses.id [delete: cascade]
Ref: business_claims.user_id > users.id [delete: cascade]
Ref: business_claims.handled_by >? users.id [delete: set null]
Table business_locations {
  id bigint [pk, increment]
  business_id bigint [not null]
  kommun_id bigint [not null]
  namn varchar [null, note: 'Överskriver företagsnamnet vid behov, t.ex. "Acme Ludvika" eller "Acme Centrum"']
  telefon varchar [null]
  adress varchar [null]
  postnummer varchar [null]
  ort varchar [null]
  lat decimal(10,7) [null]
  lng decimal(10,7) [null]
  is_primary boolean [default: true]
  status content_status [default: 'draft', note: 'Tillagd 2026-10-28: en lokalisering som skapas via revision måste vara osynlig tills den godkänns – samma publiceringsregel som allt annat innehåll. Sätts till published av ApproveRevision eller redaktionen.']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null, note: 'En nedlagd filial ska inte hårdraderas']
  indexes {
    (business_id, kommun_id) [note: 'v4: INTE unikt längre – två pizzerior med samma ägare i Ludvika, två butiker på olika gator. Lägg dessutom UNIQUE (business_id) WHERE is_primary AND deleted_at IS NULL, annars kan flera locations vara primära samtidigt.']
    (kommun_id, status) [note: 'Driver katalogens listsidor: kommun_id IN (...) AND status = published']
  }
  Note: 'URL:en bor i slugs-tabellen (per språk och ort). De flesta företag har exakt en rad här. Öppettider och lunch hänger på lokaliseringen. Katalogen visar bara rader med status published vars företag också är published.'
}
Ref: business_locations.business_id > businesses.id [delete: cascade]
Ref: business_locations.kommun_id > kommuner.id [delete: restrict]
Ref: business_category.business_id > businesses.id [delete: cascade]
Table opening_hours {
  id bigint [pk, increment]
  business_location_id bigint [not null]
  weekday smallint [note: 'v4: smallint – tinyint finns inte i PostgreSQL. 0 = måndag ... 6 = söndag']
  opens time [null]
  closes time [null]
  closed boolean [default: false]
  indexes {
    (business_location_id, weekday) [note: 'v4: INTE unikt längre – en krog med 11–14 och 17–21 behöver två rader för samma dag. Sortera på opens vid visning.']
  }
}
Ref: opening_hours.business_location_id > business_locations.id [delete: cascade]
Table opening_hour_exceptions {
  id bigint [pk, increment]
  business_location_id bigint [not null]
  date date
  opens time [null]
  closes time [null]
  closed boolean [default: false]
  note varchar [null, note: '"Midsommarafton", "Semesterstängt"']
  indexes {
    (business_location_id, date)
  }
  Note: 'v4: röda dagar och semesterstängt. Avvikelsen vinner alltid över opening_hours för det datumet. Det här är det första besökare klagar på när det står fel.'
}
Ref: opening_hour_exceptions.business_location_id > business_locations.id [delete: cascade]
Table lunch_menus {
  id bigint [pk, increment]
  business_location_id bigint [not null]
  iso_year smallint [note: 'v4: ISO-år, inte kalenderår – vecka 1 kan börja i december']
  week smallint
  menu json [note: '{"mon": [...], "tue": [...]}']
  status content_status [default: 'draft']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null, note: 'v4: saknades fast allt annat hade det']
  indexes {
    (business_location_id, iso_year, week) [unique, note: 'Partiellt index (WHERE deleted_at IS NULL)']
  }
  Note: 'v4: följer samma publiceringsregel som allt annat – draft tills en revision godkänns, inte ett eget pending-tillstånd.'
}
Ref: lunch_menus.business_location_id > business_locations.id [delete: cascade]
// ============================================
// EVENEMANG
// ============================================
Table events {
  id bigint [pk, increment]
  kommun_id bigint [not null, note: 'v4: sätts av observern ENDAST om den är null. Skriv aldrig över – en arrangör i Ludvika kan hålla ett event i Smedjebacken, och då ska det synas där det äger rum.']
  business_location_id bigint [null, note: 'Arrangör/plats om den finns i katalogen']
  parent_event_id bigint [null, note: 'v4: satt = en förekomst av ett återkommande event']
  recurrence_rule varchar [null, note: 'v4: RRULE på moderposten, t.ex. FREQ=WEEKLY;BYDAY=TU. Förekomster materialiseras som barnrader av ett schemalagt job – då fungerar kalender, sök och promotions oförändrat.']
  created_by bigint [null]
  namn varchar
  beskrivning json
  all_day boolean [default: false, note: 'v4: heldagsarrangemang slapp annars inte ifrån ett påhittat klockslag']
  starts_at datetime
  ends_at datetime [null]
  venue_name varchar [null, note: 'Fritext om platsen inte finns i katalogen']
  adress varchar [null]
  lat decimal(10,7) [null]
  lng decimal(10,7) [null]
  pris varchar [null]
  ticket_url varchar [null]
  status content_status [default: 'draft']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  indexes {
    (kommun_id, status, starts_at)
    (kommun_id, status, ends_at) [note: 'v4: för "pågår just nu"-frågor – ends_at > now sorterar inte på starts_at-indexet']
    parent_event_id
  }
  Note: 'URL:en bor i slugs-tabellen. Pubquiz varje tisdag och Nyhammarsfesten varje år läggs in en gång, inte trettio.'
}
Ref: events.kommun_id > kommuner.id [delete: restrict]
Ref: events.business_location_id >? business_locations.id [delete: set null]
Ref: events.parent_event_id >? events.id [delete: cascade]
Ref: events.created_by >? users.id [delete: set null]
Ref: event_category.event_id > events.id [delete: cascade]
// ============================================
// REPORTAGE
// ============================================
Table articles {
  id bigint [pk, increment]
  kommun_id bigint [not null]
  author_id bigint [null, note: 'v4: nullable – en användare som begär GDPR-radering blockerades annars av sina egna artiklar. ON DELETE SET NULL + visningsnamn i author_name.']
  author_name varchar [null, note: 'v4: bevaras även om kontot raderas – bylinen ska inte försvinna ur arkivet']
  titel json
  ingress json
  body json
  featured boolean [default: false]
  status content_status [default: 'draft']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  indexes {
    (kommun_id, status, published_at)
  }
  Note: 'URL:en bor i slugs-tabellen – en per språk, plus de gamla Wagtail-sökvägarna som icke-kanoniska rader.'
}
Ref: articles.kommun_id > kommuner.id [delete: restrict]
Ref: articles.author_id >? users.id [delete: set null]
// ============================================
// STATISKA SIDOR
// ============================================
Table pages {
  id bigint [pk, increment]
  kommun_id bigint [null, note: 'null = nationell sida (integritetspolicy), satt = ortspecifik ("Om Allt om Ludvika")']
  titel json
  body json [note: 'Översättningsbar, HTML från rich text-editor']
  status content_status [default: 'draft']
  published_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  Note: 'Ortspecifik sida överskrider nationell vid samma slug. URL:en bor i slugs-tabellen, som redan hanterar kommun_id = null korrekt via två partiella index – v3:s coalesce-trick behövs inte längre.'
}
Ref: pages.kommun_id >? kommuner.id [delete: restrict]
// ============================================
// GODKÄNNANDEFLÖDE
// ============================================
Table revisions {
  id bigint [pk, increment]
  revisionable_type varchar [note: 'Polymorf: Business / BusinessLocation / Event / Article / LunchMenu / Offer / Page']
  revisionable_id bigint
  submitted_by bigint [null, note: 'v4: nullable för GDPR-radering']
  payload json
  status revision_status [default: 'pending']
  reviewed_by bigint [null]
  reviewed_at timestamp [null]
  review_comment text [null]
  applied_at timestamp [null, note: 'v4: när payload faktiskt skrevs till raden. Skiljer "godkänd" från "genomförd" när något går fel i observern.']
  created_at timestamp
  updated_at timestamp
  indexes {
    (revisionable_type, revisionable_id)
    status [note: 'Granskningskön i Filament']
  }
  Note: 'Polymorf – ritas inte som FK. INKORG, inte tillstånd: raden i innehållstabellen rörs först vid godkännande, då payload skrivs dit, status sätts och applied_at stämplas. Avslag rör aldrig raden. RADERA INTE godkända rader – de är gratis versionshistorik.'
}
Ref: revisions.submitted_by >? users.id [delete: set null]
Ref: revisions.reviewed_by >? users.id [delete: set null]
// ============================================
// MEDIA (Spatie medialibrary, förenklad)
// ============================================
Table media {
  id bigint [pk, increment]
  model_type varchar [note: 'Polymorf: Business / Event / Article / Page – kopplingen bor i Eloquent (morphMany)']
  model_id bigint
  collection_name varchar [note: 'Ägaruppladdningar → "pending"-collection, flyttas till publik collection först vid godkännande – annars smiter bilder förbi granskningen']
  file_name varchar
  mime_type varchar [null]
  size bigint
  custom_properties json
  created_at timestamp
  updated_at timestamp
  indexes {
    (model_type, model_id)
    (collection_name, created_at) [note: 'v4: driver städjobbet nedan']
  }
  Note: 'Ingen ON DELETE CASCADE (polymorf) – Spatie städar vid modellradering. v4: schemalagt job som rensar pending-media vars revision avslagits eller som legat orörd i X dagar, annars växer lagringen tyst.'
}
// ============================================
// NYHETSBREV
// ============================================
Table newsletter_subscribers {
  id bigint [pk, increment]
  kommun_id bigint [not null]
  email varchar
  token uuid [unique, note: 'v4: unikt index – avprenumerationslänken slår upp på token']
  consented_at timestamp [note: 'GDPR-samtycke']
  consent_ip varchar(45) [null, note: 'v4: bevis för hur samtycket gavs – går inte att rekonstruera i efterhand']
  consent_source varchar [null, note: 'v4: "startsida" / "evenemangssida" / "import"']
  confirmed_at timestamp [null, note: 'Double opt-in']
  unsubscribed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (email, kommun_id) [unique]
  }
}
Ref: newsletter_subscribers.kommun_id > kommuner.id [delete: restrict]
// ============================================
// CROSS-MARKETING FAS 1: PROMOTIONS
// ============================================
Table promotions {
  id bigint [pk, increment]
  promotable_type varchar [note: 'Polymorf: BusinessLocation / Event / Article / Offer']
  promotable_id bigint
  kommun_id bigint [not null, note: 'Orten där innehållet visas (utöver hemkommunen)']
  placement promotion_placement
  status promotion_status [default: 'draft', note: 'v4: pausa utan att skriva om datumen fram och tillbaka']
  starts_at datetime
  ends_at datetime [null]
  priority smallint [default: 0]
  is_paid boolean [default: false, note: 'true → visas med "Annons"-etikett (marknadsföringslagen)']
  price decimal(10,2) [null]
  invoiced_at timestamp [null]
  created_by bigint [null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (kommun_id, placement, status, starts_at, ends_at) [note: 'Aktiva placeringar per yta']
    (promotable_type, promotable_id)
  }
  Note: 'Startsidan = ordinarie innehåll för kommunen + aktiva promotions riktade hit. Länkar pekar alltid till innehållets kanoniska URL. OBS: price/invoiced_at är embryot till fakturering – flytta ut det till en egen modell så fort det blir mer än en handfull rader.'
}
Ref: promotions.kommun_id > kommuner.id [delete: restrict]
Ref: promotions.created_by >? users.id [delete: set null]
// ============================================
// CROSS-MARKETING FAS 2: OFFERS
// ============================================
Table offers {
  id bigint [pk, increment]
  business_id bigint [not null]
  titel json
  beskrivning json
  discount_type varchar [null, note: 'percentage / fixed / freebie']
  discount_value decimal(10,2) [null]
  code varchar [null]
  starts_at datetime [null]
  ends_at datetime [null]
  status content_status [default: 'draft', note: 'Går genom revisions-kön som allt annat']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  indexes {
    (business_id, status)
  }
  Note: 'Synliggörs via promotions (t.ex. på partnerortens startsida)'
}
Ref: offers.business_id > businesses.id [delete: cascade]
// ============================================
// FRAMTID – FAS 3 (byggs vid bevisad efterfrågan)
// Ska INTE migreras i v1.
// ============================================
Enum partnership_status {
  proposed
  active
  paused
  ended
}
Enum partnership_type {
  referral
  cross_promotion
  bundle
  sponsorship
}
Enum campaign_status {
  draft
  active
  paused
  completed
}
Table framtid_business_partnerships {
  id bigint [pk, increment]
  business_id bigint [not null]
  partner_business_id bigint [not null]
  type partnership_type
  status partnership_status [default: 'proposed']
  name varchar [null]
  starts_at datetime [null]
  ends_at datetime [null]
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp
  Note: 'FAS 3. Samarbete mellan två företag, t.ex. hotell ↔ restaurang.'
}
Ref: framtid_business_partnerships.business_id > businesses.id
Ref: framtid_business_partnerships.partner_business_id > businesses.id
Table framtid_campaigns {
  id bigint [pk, increment]
  lan_id bigint [null, note: 'Regional kampanj, t.ex. "Sommar i Dalarna"']
  kommun_id bigint [null, note: 'Eller lokal – en av dessa sätts']
  name varchar
  slug varchar
  starts_at datetime
  ends_at datetime [null]
  status campaign_status [default: 'draft']
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp
  Note: 'FAS 3. Tidsbegränsad kampanj med flera deltagande företag.'
}
Ref: framtid_campaigns.lan_id >? lan.id
Ref: framtid_campaigns.kommun_id >? kommuner.id
Table framtid_campaign_business {
  campaign_id bigint
  business_id bigint
  role varchar [note: 'partner / sponsor / participant']
  indexes {
    (campaign_id, business_id) [pk]
  }
}
Ref: framtid_campaign_business.campaign_id > framtid_campaigns.id
Ref: framtid_campaign_business.business_id > businesses.id
Table framtid_referrals {
  id bigint [pk, increment]
  campaign_id bigint [null]
  partnership_id bigint [null]
  offer_id bigint [null]
  source_business_id bigint [not null]
  target_business_id bigint [not null]
  referral_code varchar [null]
  converted boolean [default: false]
  value decimal(10,2) [null]
  occurred_at timestamp
  created_at timestamp
  Note: 'FAS 3. OBS: kräver att köp faktiskt rapporteras in (kassaintegration eller manuellt) – lös det innan tabellen byggs.'
}
Ref: framtid_referrals.source_business_id > businesses.id
Ref: framtid_referrals.target_business_id > businesses.id
Ref: framtid_referrals.offer_id >? offers.id
Ref: framtid_referrals.partnership_id >? framtid_business_partnerships.id
Ref: framtid_referrals.campaign_id >? framtid_campaigns.id
// ============================================
// FRAMTID – FAS 4: AUDIENCES (målgrupper)
// ============================================
Table framtid_audiences {
  id bigint [pk, increment]
  name varchar [note: 'Barnfamiljer / Turister / Seniorer ...']
  slug varchar [unique]
  created_at timestamp
  updated_at timestamp
  Note: 'FAS 4. Grund för framtida partnermatchning.'
}
Table framtid_business_audience {
  business_id bigint
  audience_id bigint
  indexes {
    (business_id, audience_id) [pk]
  }
}
Ref: framtid_business_audience.business_id > businesses.id
Ref: framtid_business_audience.audience_id > framtid_audiences.id
// ============================================
// FRAMTID – SPORT (förberedd, byggs som egen modul)
// Nyckelidé: en match ÄR ett event (1:1-utökning).
// Kalender, godkännandeflöde, promotions och sök
// följer då med gratis. Föreningar bor i businesses
// (kind = association), anläggningar i business_locations,
// sporter i categories (type = sport).
// ============================================
Table framtid_teams {
  id bigint [pk, increment]
  business_id bigint [not null, note: 'Klubben/föreningen i businesses']
  category_id bigint [not null, note: 'Sporten – categories med type = sport']
  namn varchar [note: '"A-lag herr", "P12"']
  slug varchar
  external_id varchar [null, note: 'v4: lagets id hos förbundet/resultatkällan – nyckeln som standings matchar mot']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]
  indexes {
    (business_id, slug) [unique]
    external_id
  }
}
Ref: framtid_teams.business_id > businesses.id
Ref: framtid_teams.category_id > categories.id
Table framtid_series {
  id bigint [pk, increment]
  namn varchar [note: '"Division 3 Västra Svealand"']
  season varchar [note: '"2026/2027"']
  category_id bigint [not null]
  external_id varchar [null, note: 'ID hos extern datakälla (förbunds-/resultat-API) för synk av resultat och tabeller']
  created_at timestamp
  updated_at timestamp
  Note: 'Resultat (matches) och tabell (standings) kopplas hit; external_id driver API-synken.'
}
Ref: framtid_series.category_id > categories.id
Table framtid_matches {
  id bigint [pk, increment]
  event_id bigint [null, unique, note: '1:1 när satt – matchen ÄR då ett event och syns i kalendern. null = ren resultatrad, t.ex. match mellan två bortalag i samma serie']
  series_id bigint [null]
  home_team_id bigint [null]
  home_team_name varchar [null, note: 'Fritext om laget inte finns i systemet – samma mönster som events.venue_name']
  away_team_id bigint [null]
  away_team_name varchar [null]
  home_score smallint [null, note: 'null tills matchen spelats']
  away_score smallint [null]
  played_at datetime [null, note: 'v4: speltid för resultatrader utan event']
  match_status varchar [default: 'scheduled', note: 'scheduled / live / finished / postponed']
  created_at timestamp
  updated_at timestamp
  Note: 'Match med event_id syns i kalendern; match utan är en resultatrad så hela omgången kan visas. Resultat och tabeller är faktauppgifter: auto-publicera dem, skicka dem inte genom godkännandekön.'
}
Ref: framtid_matches.event_id -? events.id
Ref: framtid_matches.series_id >? framtid_series.id
Ref: framtid_matches.home_team_id >? framtid_teams.id
Ref: framtid_matches.away_team_id >? framtid_teams.id
Table framtid_standings {
  id bigint [pk, increment]
  series_id bigint [not null]
  team_id bigint [null, note: 'Länk till lokalt lag när det finns']
  external_team_id varchar [null, note: 'v4: nyckeln mot källan']
  team_name varchar [note: 'Visningsnamnet från källan – ändras när källan ändrar stavning, därför INTE nyckel längre']
  position smallint [note: 'Från källan – tiebreak-regler skiljer per förbund, räkna inte om själva']
  played smallint [default: 0]
  wins smallint [default: 0]
  draws smallint [default: 0]
  losses smallint [default: 0]
  score_for smallint [default: 0, note: 'Gjorda mål/poäng']
  score_against smallint [default: 0]
  points smallint [default: 0]
  extra json [null, note: 'Sportspecifikt: OT-vinster, straffvinster, sätt ...']
  synced_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (series_id, external_team_id) [unique, note: 'v4: v3 nycklade på team_name – källan byter stavning från "IFK Ludvika" till "IFK Ludvika FK" och du får en dubblettrad istället för en uppdatering']
    (series_id, position)
  }
  Note: 'Hela serietabellen – en rad per lag, inte bara lokala. Speglar källan. Beräkna själva endast om seriens samtliga matcher finns i systemet.'
}
Ref: framtid_standings.series_id > framtid_series.id
Ref: framtid_standings.team_id >? framtid_teams.id
// ---------- Grupper i diagrammet ----------
TableGroup geografi {
  lan
  kommuner
  sites
  site_kommun
}
TableGroup verksamheter {
  businesses
  business_user
  business_claims
  business_locations
  opening_hours
  opening_hour_exceptions
  lunch_menus
}
TableGroup innehall {
  events
  articles
  pages
  categories
  slugs
}
TableGroup crossmarketing_v1 {
  promotions
  offers
}
TableGroup framtid_sport {
  framtid_teams
  framtid_series
  framtid_matches
  framtid_standings
}
TableGroup framtid_fas3_4 {
  framtid_business_partnerships
  framtid_campaigns
  framtid_campaign_business
  framtid_referrals
  framtid_audiences
  framtid_business_audience
}
